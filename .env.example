# Copy to .env next to the solution and fill in. .env is gitignored.
# A real environment variable always wins over an entry here.
#
# This file holds the licence path and nothing else. There are no other secrets:
# the tool reads a local corpus and writes local session files.

# --- GroupDocs licence --------------------------------------------------------
# WITHOUT THIS, EVERY RUN IS MEANINGLESS. Trial mode caps how many documents
# GroupDocs.Search will index, while the tool still produces a full session record
# with a plausible-looking size ratio. The session stamps IsLicensed and the UI
# marks such runs, but do not rely on noticing.
#
# This is the ONLY licence setting: the full path to a .lic file. There is no folder
# convention and no fallback variable -- if it is empty or points at a missing file,
# the run is unlicensed and the session says so.
GROUPDOCS_SEARCH_LIC_PATH=

# --- Paths (optional) ---------------------------------------------------------
# The committed appsettings.json ships portable relative defaults so a fresh clone
# runs anywhere. These override them without editing a committed file.
#
# A folder of documents to index. Any layout - everything underneath is enumerated.
INDEXING_LAB_CORPUS=
# Where session records are written. Defaults to a "sessions" folder next to the app.
INDEXING_LAB_SESSIONS=
