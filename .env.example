# Copy to .env next to the solution and fill in. .env is gitignored.
# A real environment variable always wins over an entry here.
#
# This file holds the licence path and nothing else. There are no other secrets:
# the tool reads a local corpus and writes local session files.

# --- GroupDocs licence --------------------------------------------------------
# WITHOUT THIS, EVERY RUN IS MEANINGLESS. Trial mode caps how many documents
# GroupDocs.Search will index, while the tool still produces a full session record
# with a plausible-looking size ratio. The session stamps IsLicensed and the UI
# marks such runs, but do not rely on noticing.
GROUPDOCS_LIC_PATH=

# Fallback: a licences FOLDER, matching the internal convention. Used only when
# GROUPDOCS_LIC_PATH is empty; the tool appends
# Conholdate/Total/Subscription/Valid/Conholdate.Total.Product.Family.lic
LIC_PATH=
